# Copy to .env and adjust before `docker compose up`. Never commit the real .env.

# --- Postgres (one instance, four logical databases) ---
POSTGRES_USER=change-me-user
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

IDENTITY_DATABASE_URL=postgresql+asyncpg://change-me-user:change-me-dev-only@postgres:5432/identity_db
CLASSROOM_DATABASE_URL=postgresql+asyncpg://change-me-user:change-me-dev-only@postgres:5432/classroom_db
CONTENT_DATABASE_URL=postgresql+asyncpg://change-me-user:change-me-dev-only@postgres:5432/content_db
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://change-me-user:change-me-dev-only@postgres:5432/notification_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT (only identity-service signs and holds this secret; every other
# service validates tokens remotely via /internal/tokens/validate instead of
# decoding them, so the secret itself is never handed out). At least 32
# bytes for HS256, or identity-service won't start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-change-me-change-me-change-me-dev-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- 2FA (TOTP) — encrypts guardians.totp_secret at rest, a separate secret
# from JWT_SECRET on purpose. Must be a valid Fernet key: 32 url-safe
# base64-encoded bytes. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key-for-dev-only

# --- Internal service-to-service calls (defense in depth on top of network isolation) ---
INTERNAL_SERVICE_KEY=change-me-internal-key-dev-only

# --- Object storage (Garage, S3 compatible) ---
# Nothing here is reachable from the internet: every file reaches the browser
# through the API gateway, after the owning service checks access.
S3_ENDPOINT_URL=http://garage:3900
# Has to match s3_region in infra/garage/garage.toml.
S3_REGION=us-east-1
# One bucket and one key per service, each key only valid for its own bucket.
# Garage only accepts keys with this shape, generate each pair with:
#   python -c "import secrets; print('GK' + secrets.token_hex(12))"
#   python -c "import secrets; print(secrets.token_hex(32))"
CLASSROOM_S3_BUCKET=iris-classroom
CLASSROOM_S3_ACCESS_KEY=GK000000000000000000000000
CLASSROOM_S3_SECRET_KEY=change-me-64-hex-characters
CONTENT_S3_BUCKET=iris-content
CONTENT_S3_ACCESS_KEY=GK000000000000000000000000
CONTENT_S3_SECRET_KEY=change-me-64-hex-characters
# identity-service only reads (the avatars), its key can't write.
IDENTITY_S3_BUCKET=iris-identity
IDENTITY_S3_ACCESS_KEY=GK000000000000000000000000
IDENTITY_S3_SECRET_KEY=change-me-64-hex-characters
# Optional size limit of each bucket, in MB. Leave them empty to use the
# defaults (2 GB logos, 20 GB lessons, 200 MB avatars); lower them if the
# server's disk is small.
CLASSROOM_S3_QUOTA_MB=
CONTENT_S3_QUOTA_MB=
IDENTITY_S3_QUOTA_MB=
# For people only, never for a service: uploading avatars and restoring
# backups. Reads and writes the three buckets.
STORAGE_ADMIN_ACCESS_KEY=GK000000000000000000000000
STORAGE_ADMIN_SECRET_KEY=change-me-64-hex-characters
# Garage's own secrets: the RPC one between nodes and the admin API token.
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GARAGE_RPC_SECRET=change-me-64-hex-characters
GARAGE_ADMIN_TOKEN=change-me-admin-token
# Only read by old migrations and their downgrades.
S3_PUBLIC_URL=http://localhost:9000

# --- CORS ---
WEB_ORIGIN=http://localhost:5173

# --- Production only: the domain of the site. Caddy serves it with the
# institutional certificate in /etc/ssl/iris, and the deploy script uses it
# for the health check. Unused in local dev. ---
# DOMAIN=iris.bucaramanga.upb.edu.co

# IMAGE_TAG is not set here. scripts/iris-deploy.sh sets it to the release
# it is deploying (like v1.2.3), and docker-compose.prod.yml refuses to start
# without it.

# --- Host ports (dev) ---
# Caddy in front of the api-gateway (infra/caddy/Caddyfile.dev).
GATEWAY_PORT=8080
IDENTITY_PORT=8001
CLASSROOM_PORT=8002
CONTENT_PORT=8003
NOTIFICATION_PORT=8004
WEB_PORT=5173

# --- Progressive lock (login and the parents' portal 2FA) ---
# After 5 wrong attempts inside 5 minutes the account is locked 60 s, then
# 300 s, then 900 s (the last step repeats). A success, or an hour without
# new locks, starts over. All optional, these are the defaults.
# LOCKOUT_MAX_FAILURES=5
# LOCKOUT_FAILS_WINDOW_SEC=300
# LOCKOUT_WAIT_STEPS_SEC=[60,300,900]
# LOCKOUT_RESET_AFTER_SEC=3600
# Cap per account, whatever the session or IP: 20 failures in an hour
# lock it 15 minutes.
# ACCOUNT_LOCKOUT_MAX_FAILURES=20
# ACCOUNT_LOCKOUT_FAILS_WINDOW_SEC=3600
# ACCOUNT_LOCKOUT_WAIT_SEC=900
# Student PIN, shorter waits.
# PIN_LOCKOUT_MAX_FAILURES=6
# PIN_LOCKOUT_FAILS_WINDOW_SEC=600
# PIN_LOCKOUT_WAIT_STEPS_SEC=[30,120,300]
# A used refresh token shown again after this many seconds closes the session.
# REFRESH_REUSE_GRACE_SEC=10

# --- Rate limiting ---
# Per IP at the api-gateway (requests per window).
# RATE_LIMIT_GENERAL_MAX=300
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_ENROLLMENT_MAX=5
RATE_LIMIT_ENROLLMENT_WINDOW_SEC=600

VITE_API_BASE_URL=http://localhost:8080/api
# Uncomment on a dev machine without a camera to force the mouse fallback
# instead of trying to load the real EyeGestures engine (see README, Eye
# tracking section).
# VITE_GAZE_SOURCE=mouse
