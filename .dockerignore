# Applies only to the "web" build (the only service whose context is the
# monorepo root, see docker-compose.yml). Keeps that build context lean.
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/node_modules
**/dist
**/.vite
**/coverage
**/*.db
.git

# Other local tooling.
.claude/
.agents/

# The real .env is never copied by any current Dockerfile (each one lists
# its own files by name instead of a broad "COPY . ."), but this stays here
# as a safety net in case that ever changes. .env.example has no real
# secrets, so it's fine to keep out of this list.
.env
.env.*
!.env.example
