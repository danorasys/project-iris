# Shell scripts run inside Linux containers — a CRLF shebang line
# ("#!/bin/bash\r") makes the kernel look for a literal "/bin/bash\r"
# interpreter, which doesn't exist. Force LF regardless of what a Windows
# checkout (core.autocrlf=true) would otherwise do.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
