[Unit]
Description=IRIS backup of the Garage buckets
Documentation=file:///opt/iris/docs/deployment.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/sbin/iris-backup-media
TimeoutStartSec=1h

# The script only needs Docker, the env file and its own backup folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/backups/iris-media
