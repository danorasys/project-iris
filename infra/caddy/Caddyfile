# HTTPS uses the university's wildcard certificate, which the server keeps in
# /etc/ssl/iris (mounted at /certs, see docker-compose.prod.yml). It is not in
# this repo and must never be. fullchain.pem is the certificate plus its
# intermediates. When the certificate is renewed, replace those two files and
# restart the reverse-proxy container.
{$DOMAIN} {
	tls /certs/fullchain.pem /certs/webssl.key

	encode gzip

	# Same headers as apps/web/nginx.conf, repeated because this is the edge.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Same policy as apps/web/nginx.conf (the reasons are there). With "?"
		# it's only added when the response has none, so the stricter one of
		# the private images stays.
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net/npm/@mediapipe/; connect-src 'self' https://cdn.jsdelivr.net/npm/@mediapipe/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# API and private images, the same as in local dev.
	import api.caddy

	handle {
		reverse_proxy web:8080
	}
}
