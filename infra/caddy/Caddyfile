# HTTPS uses the university's wildcard certificate, which the server keeps in
# /etc/ssl/iris (mounted at /certs, see docker-compose.prod.yml). It is not in
# this repo and must never be. fullchain.pem is the certificate plus its
# intermediates. When the certificate is renewed, replace those two files and
# restart the reverse-proxy container.
{$DOMAIN} {
    tls /certs/fullchain.pem /certs/webssl.key

    encode gzip

    # Same headers as apps/web/nginx.conf, repeated because this is the edge.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # The BFF already expects the /api prefix itself (see api-gateway's
    # routes_proxy.py), so this just forwards as-is, no path rewriting.
    handle /api/* {
        reverse_proxy api-gateway:8000
    }

    # MinIO uses path-style URLs (/<bucket>/<key>), so /media is stripped
    # before forwarding. It has no public port, this is the only way in.
    handle /media/* {
        uri strip_prefix /media
        reverse_proxy minio:9000
    }

    handle {
        reverse_proxy web:80
    }
}
